# Dependencias de Node (se instalan con `npm ci` en GitHub Actions)
# OJO: package-lock.json NO se ignora, tiene que estar en el repo para que `npm ci` funcione.
node_modules/

# Archivos generados por Gradle / Android Studio (se regeneran al compilar)
android/.gradle/
android/app/build/
android/build/
android/*.iml
android/app/*.iml
android/local.properties

# APK compiladas (se descargan desde GitHub Actions, no se suben al repo)
*.apk
*.aab

# Keystore debug: NO se sube al repo (ver LEEME_APK.md).
# Es solo de depuración, con las claves por defecto (android/android), y en
# GitHub Actions se restaura desde el secreto GARTIC_MOVIL_DEBUG_KEYSTORE_B64.
# Si se subiera a un repo público, cualquiera podría firmar una APK debug
# con la misma clave y actualizar por encima de la app instalada.
keystore/

# Sistema y editores
.DS_Store
Thumbs.db
.idea/
*.log

# Audios de referencia de la v2.3 (medición de sonidos de Vegetta777):
# muy pesados (audio-2h.m4a 113 MB supera el límite de 100 MB por
# archivo de GitHub; los WAV suman ~350 MB). Se quedan solo en local.
# Las medidas están documentadas en LEEME_APK.md y los scripts, CSV,
# espectrogramas y segmentos de audio sí se suben; el audio completo
# se puede volver a descargar de YouTube con yt-dlp (IDs en el LEEME).
VERIFICACION/v2.3-referencias/*.m4a
VERIFICACION/v2.3-referencias/sonidos/*.m4a
VERIFICACION/v2.3-referencias/sonidos/*.webm
VERIFICACION/v2.3-referencias/sonidos/audio-*.wav
